# =====================================================================
# SwarmCompute — environment template
# Copy to `.env` (git-ignored). NEVER commit real keys or seed phrases.
# Every value below is validated at startup by apps/backend/src/config/env.ts;
# the backend refuses to start on anything that is not NEAR Testnet.
# `pnpm --filter @swarmcompute/backend testnet:setup` fills in the NEAR values
# and generates both encryption keys.
# =====================================================================

# ---------- Runtime ----------
NODE_ENV=development
# Hosting platforms usually set PORT; BACKEND_PORT overrides it.
BACKEND_PORT=4000
# Browser origins allowed to call the API ("*" = any).
CORS_ORIGINS=*

# ---------- Database (keystore, bid secrets, tx log; the contract is authoritative) ----------
DATABASE_URL=postgres://swarm:swarm_dev_only@localhost:5432/swarmcompute

# ---------- NEAR (testnet only) ----------
NEAR_NETWORK=testnet
# rpc.testnet.near.org is heavily rate-limited; the setup script uses FastNEAR.
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_EXPLORER_TX_URL=https://testnet.nearblocks.io/txns/

# Marketplace contract. Keep its account id short: agents are <name>.<contract>
# and NEAR account ids are at most 64 characters.
MARKETPLACE_CONTRACT_ID=market.your-dev-account.testnet

# Roles. They may be the same account. Neither is ever an agent.
# OWNER: role rotation and pause (deployment scripts only, never the running host).
# OPERATOR: forms coalitions, opens rounds, runs the simulated delivery steps.
# VERIFIER: the only account allowed to call verify().
OWNER_ACCOUNT_ID=your-dev-account.testnet
OPERATOR_ACCOUNT_ID=your-dev-account.testnet
VERIFIER_ACCOUNT_ID=your-dev-account.testnet

# Private keys (format: ed25519:<base58>). Backend environment ONLY.
OPERATOR_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=

# ---------- Encryption at rest (exactly 32 bytes hex each, and different) ----------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts agents' private keys (users' agents stop working if this is lost).
KEYSTORE_ENCRYPTION_KEY=
# Encrypts unrevealed bid prices and nonces.
BID_ENCRYPTION_KEY=

# ---------- Market host ----------
HOST_TICK_SECONDS=8
# Auction phase lengths, in chain seconds.
PREPAY_SECS=180
COMMIT_SECS=60
REVEAL_SECS=60
DELIVERY_SECS=600
VERIFICATION_SECS=600
# After a failed round, a buyer isn't regrouped until sellers change or this passes.
RETRY_COOLDOWN_SECS=900

# ---------- Frontend (PUBLIC — bundled into the browser) ----------
# Only non-secret values may use the VITE_ prefix. No keys here, ever.
VITE_NEAR_NETWORK=testnet
VITE_MARKETPLACE_CONTRACT_ID=market.your-dev-account.testnet
VITE_BACKEND_URL=http://localhost:4000
VITE_NEAR_EXPLORER_TX_URL=https://testnet.nearblocks.io/txns/
