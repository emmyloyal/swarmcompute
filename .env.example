# =====================================================================
# SwarmCompute — environment template
# Copy to `.env` (git-ignored). NEVER commit real keys or seed phrases.
# Every value below is validated at startup by apps/backend/src/config/env.ts;
# the backend refuses to start on anything that is not NEAR Testnet.
# `pnpm --filter @swarmcompute/backend testnet:setup` fills in the NEAR values.
# =====================================================================

# ---------- Runtime ----------
NODE_ENV=development
BACKEND_PORT=4000
LOG_LEVEL=info

# ---------- Database (cache + index; the contract is authoritative) ----------
DATABASE_URL=postgres://swarm:swarm_dev_only@localhost:5432/swarmcompute

# ---------- NEAR (testnet only) ----------
NEAR_NETWORK=testnet
# rpc.testnet.near.org is heavily rate-limited; the setup script uses FastNEAR.
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_EXPLORER_TX_URL=https://testnet.nearblocks.io/txns/

# Marketplace contract
MARKETPLACE_CONTRACT_ID=market.your-dev-account.testnet

# Roles. They may be the same account in the demo.
# OWNER: role rotation and pause (deployment scripts only, never the running backend).
# OPERATOR: registrations, auctions, delivery steps.
# VERIFIER: the only account allowed to call verify().
# FUNDER: the demo wallet that tops up the buyer wallets at setup.
OWNER_ACCOUNT_ID=your-dev-account.testnet
OPERATOR_ACCOUNT_ID=your-dev-account.testnet
FUNDER_ACCOUNT_ID=your-dev-account.testnet
VERIFIER_ACCOUNT_ID=your-dev-account.testnet

# Private keys (format: ed25519:<base58>). Backend environment ONLY.
OPERATOR_PRIVATE_KEY=
FUNDER_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=

# Buyer agents' own wallets: buyer001.<parent> … buyer020.<parent>.
# Each prepays its own maximum and receives its returned balance and refunds.
BUYER_WALLET_PARENT=your-dev-account.testnet
BUYER_PRIVATE_KEY=

# Real payout destinations for the 5 simulated sellers, in order seller-01..seller-05
SELLER_PAYOUT_ACCOUNTS=seller1.your-dev-account.testnet,seller2.your-dev-account.testnet,seller3.your-dev-account.testnet,seller4.your-dev-account.testnet,seller5.your-dev-account.testnet

# ---------- Agent messaging ----------
# 32+ random bytes, hex. Per-agent HMAC keys are derived from this.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_HMAC_MASTER_SECRET=
# Messages older than this (or this far in the future) are rejected.
MESSAGE_MAX_AGE_SECONDS=300

# ---------- Sealed-bid secrets at rest ----------
# Exactly 32 bytes, hex (AES-256-GCM). Encrypts unrevealed prices and nonces.
BID_ENCRYPTION_KEY=

# ---------- Simulation ----------
# Same seed + same inputs => same coalitions and bids.
SIMULATION_SEED=swarmcompute-demo-seed-1

# ---------- Frontend (PUBLIC — bundled into the browser) ----------
# Only non-secret values may use the VITE_ prefix. No keys here, ever.
VITE_NEAR_NETWORK=testnet
VITE_MARKETPLACE_CONTRACT_ID=market.your-dev-account.testnet
VITE_BACKEND_URL=http://localhost:4000
VITE_NEAR_EXPLORER_TX_URL=https://testnet.nearblocks.io/txns/
